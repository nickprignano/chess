// Cloudflare Workers: serves this folder as static files, and runs worker/index.js only for
// /coach and /api (the AI coach, the idea box and live rooms). Setup steps are in docs/DEPLOY.md.
{
  "name": "chess",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-08",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/coach", "/coach/*", "/api/*"]
  },
  // Spend and usage counters (worker/budget.js), and one object per live room (worker/room.js).
  "durable_objects": {
    "bindings": [{ "name": "BUDGET", "class_name": "Budget" }, { "name": "ROOM", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Budget"] }, { "tag": "v2", "new_sqlite_classes": ["Room"] }],
  // Ideas from the in-app idea box, and the codes of open live rooms. No ids: Wrangler creates
  // the namespaces on deploy.
  "kv_namespaces": [{ "binding": "IDEAS" }, { "binding": "ROOMS" }],
  // A cheap first filter in front of the Budget counters, per account (best effort), and one
  // per address for making and finding rooms, so codes can't be guessed.
  "ratelimits": [
    { "name": "COACH_LIMIT", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    { "name": "ROOM_LIMIT", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } }
  ],
  // No request logs: the Worker keeps no records of games or people.
  "observability": { "enabled": false }
}
